generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DEVELOPER
  ADMIN
  SCHEDULE_MAKER
  HEAD_OPERATIONAL
  STAFF
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum StaffRole {
  PIC
  SENIOR_CREW
  JUNIOR_CREW
  INHOUSE
}

enum EventStatus {
  DRAFTED
  SCHEDULED
  READY
  ONGOING
  PENDING_EVALUATION
  COMPLETED
  CANCELLED
}

enum RoleInEvent {
  PIC
  CREW
}

enum AssignmentStatus {
  ASSIGNED
  CONFIRMED
  REPLACED
  CANCELLED
}

enum StaffAvailabilityType {
  LIBUR
  IZIN
  SAKIT
  CUTI
  BLOCKED
}

enum StaffAvailabilityStatus {
  ACTIVE
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(SCHEDULE_MAKER)
  status       AccountStatus @default(ACTIVE)

  eventEvaluations      EventEvaluation[]
  staffEventEvaluations StaffEventEvaluation[]
  eventActivityLogs     EventActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Sales {
  id        String        @id @default(cuid())
  name      String
  phone     String?
  birthDate DateTime?
  notes     String?
  status    AccountStatus @default(ACTIVE)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sales")
}

model Staff {
  id                   String        @id @default(cuid())
  name                 String
  phone                String?
  birthDate            DateTime?
  defaultRole          StaffRole
  canBeAssignedToEvent Boolean       @default(true)
  status               AccountStatus @default(ACTIVE)
  notes                String?

  assignments      EventAssignment[]
  staffEvaluations StaffEventEvaluation[]
  availabilityBlocks StaffAvailabilityBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff")
}

model StaffAvailabilityBlock {
  id        String @id @default(cuid())

  staffId   String
  staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  type      StaffAvailabilityType
  status    StaffAvailabilityStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime

  isFullDay Boolean @default(true)
  startTime String?
  endTime   String?

  reason    String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([type])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model ServiceType {
  id                     String  @id @default(cuid())
  name                   String  @unique
  description            String?
  requiresRibbonTracking Boolean @default(false)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_types")
}

model Event {
  id          String  @id @default(cuid())
  eventName   String
  clientName  String
  clientPhone String?

  serviceTypeId  String
  equipmentSetup String  @default("Not specified")
  salesId        String?

  eventDate   DateTime
  startTime   String
  endTime     String
  loadingDate DateTime?
  loadingTime String?

  location String?
  status   EventStatus @default(DRAFTED)

  vehicleName String?
  driverName  String?

  ribbonStart Int?
  ribbonEnd   Int?
  ribbonUsed  Int?

  vendorSewa String?
  notes      String?

  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])
  sales       Sales?      @relation(fields: [salesId], references: [id])

  assignments      EventAssignment[]
  eventEvaluation  EventEvaluation?
  staffEvaluations StaffEventEvaluation[]
  activityLogs     EventActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

model EventAssignment {
  id               String           @id @default(cuid())
  eventId          String
  staffId          String
  roleInEvent      RoleInEvent
  assignmentStatus AssignmentStatus @default(ASSIGNED)
  notes            String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, staffId])
  @@map("event_assignments")
}

model EventEvaluation {
  id                   String  @id @default(cuid())
  eventId              String  @unique
  evaluatorUserId      String
  clientSatisfactionOk Boolean @default(false)
  clientFeedback       String?
  notes                String?

  event         Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  evaluatorUser User  @relation(fields: [evaluatorUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_evaluations")
}

model StaffEventEvaluation {
  id              String @id @default(cuid())
  eventId         String
  staffId         String
  evaluatorUserId String

  sopOk            Boolean @default(false)
  warehouseOk      Boolean @default(false)
  groomingOk       Boolean @default(false)
  dataCollectionOk Boolean @default(false)
  isSuccess        Boolean @default(false)

  notes String?

  event         Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff         Staff @relation(fields: [staffId], references: [id])
  evaluatorUser User  @relation(fields: [evaluatorUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, staffId])
  @@map("staff_event_evaluations")
}

model EventActivityLog {
  id          String  @id @default(cuid())
  eventId     String
  userId      String?
  action      String
  description String?
  metadata    Json?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("event_activity_logs")
}
